; Inno Setup 6 script. Build with scripts\release.ps1, which passes the version:
;   ISCC /DVersion=1.0.0 installer\nts-client.iss

#ifndef Version
  #error Pass the version, e.g. ISCC /DVersion=1.0.0 installer\nts-client.iss
#endif
#define Repo "Wilsoon7721/ntp-nts-client"

[Setup]
; Never change AppId: it's how upgrades find the existing install
AppId={{F32E7BFD-4347-429C-BA5C-D0330ED45D89}
AppName=NTS Client
AppVersion={#Version}
AppVerName=NTS Client {#Version}
AppPublisherURL=https://github.com/{#Repo}
AppUpdatesURL=https://github.com/{#Repo}/releases
; Program Files, so the service account (LOCAL SERVICE) can read the exe
DefaultDirName={autopf}\nts-client
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=..\dist
OutputBaseFilename=nts-client-setup-{#Version}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
SetupIconFile=..\assets\icon.ico
UninstallDisplayName=NTS Client
UninstallDisplayIcon={app}\nts-tray.exe
; The tray and service are stopped in PrepareToInstall instead
CloseApplications=no
SetupLogging=yes

[Files]
Source: "..\target\release\nts-client.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\target\release\nts-tray.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\LICENSE"; DestDir: "{app}"; DestName: "LICENSE.txt"; Flags: ignoreversion
; Generated by scripts\release.ps1 with cargo-about
Source: "..\target\THIRD-PARTY-NOTICES.txt"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\NTS Client"; Filename: "{app}\nts-tray.exe"

[Run]
; Runs in silent installs too, so the tray comes back after an update.
; As the signed-in user, not elevated like the installer.
Filename: "{app}\nts-tray.exe"; Flags: nowait runasoriginaluser

[UninstallRun]
Filename: "{sys}\taskkill.exe"; Parameters: "/F /IM nts-tray.exe"; Flags: runhidden; RunOnceId: "StopTray"
; Also sets Windows Time back to manual start
Filename: "{app}\nts-client.exe"; Parameters: "--uninstall"; Flags: runhidden waituntilterminated; RunOnceId: "RemoveService"

[UninstallDelete]
; Service config and logs
Type: filesandordirs; Name: "{commonappdata}\nts-client"

[Code]
const
  RunKey = 'Software\Microsoft\Windows\CurrentVersion\Run';
  ApprovedKey = 'Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run';

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Code: Integer;
begin
  Result := '';
  // Files in use can't be replaced: close the tray and stop the service
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM nts-tray.exe', '', SW_HIDE,
    ewWaitUntilTerminated, Code);
  if FileExists(ExpandConstant('{app}\nts-client.exe')) then
    Exec(ExpandConstant('{app}\nts-client.exe'), '--stop', '', SW_HIDE,
      ewWaitUntilTerminated, Code);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Code: Integer;
  ErrorFile: String;
  Message: AnsiString;
begin
  if CurStep <> ssPostInstall then
    Exit;
  WizardForm.StatusLabel.Caption := 'Starting the NTS Client service...';
  ErrorFile := ExpandConstant('{tmp}\service-error.txt');
  // Registers the service (or updates an existing one), disables Windows Time and starts it
  if not Exec(ExpandConstant('{app}\nts-client.exe'),
      '--install --start --error-file "' + ErrorFile + '"', '', SW_HIDE,
      ewWaitUntilTerminated, Code) or (Code <> 0) then
  begin
    if not LoadStringFromFile(ErrorFile, Message) then
      Message := 'nts-client exited with code ' + IntToStr(Code);
    SuppressibleMsgBox('The NTS Client service could not be started:' + #13#10#13#10 +
      String(Message) + #13#10#13#10 +
      'Open NTS Client from the Start menu to try again.', mbError, MB_OK, IDOK);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep <> usPostUninstall then
    Exit;
  // Written by the tray app for whoever ran it; this cleans up the uninstalling user's
  RegDeleteValue(HKCU, RunKey, 'NTS Client');
  RegDeleteValue(HKCU, ApprovedKey, 'NTS Client');
  DelTree(ExpandConstant('{userappdata}\nts-client'), True, True, True);
end;
